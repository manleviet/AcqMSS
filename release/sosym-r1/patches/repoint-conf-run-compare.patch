 # KB Comparison Configuration
 # Compare learned KBs against ground truth feature models.
 # Run with: python -m apps.run_compare apps/conf/run_compare_config.toml -v
+#
+# ⚠ kb_dir is BOTH the input and the output: run_compare writes each evaluation back
+# into the file it read. That is what you want for your own run, and destructive for
+# a committed tree. Every kb_dir below therefore names `scratch/`, which is where
+# `python -m apps.run_cv <cell config> -o scratch` puts its results.
 
 [general]
 # Default output dir for eval JSON files (overridden by per-model kb_dir)
-output_dir = "data/results"
+output_dir = "scratch"
 verbose = true
 
